main {
  int contador, limite, acumulado;
  float promedio;
  bool activo;

  contador = 0;
  limite = 5;
  acumulado = 0;
  promedio = 0.0;
  activo = true;

  while (contador < limite) {
    acumulado = acumulado + contador ^ 2;
    contador++;
  };

  promedio = acumulado / limite;

  if (activo && promedio >= 2.0) then
    cout promedio;
  else
    cout acumulado;
  end;

  do
    limite = limite + 1;
  while (limite < 8) {
    acumulado = acumulado + 1;
  };
  until (limite >= 8);

  cout limite;
}
