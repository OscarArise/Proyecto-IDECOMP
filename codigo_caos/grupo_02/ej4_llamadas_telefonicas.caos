// Grupo 2 - Ejercicio 4 (repetitivo)
// Costo de un conjunto de llamadas. Por cada llamada se lee el tipo y la duracion:
//   tipo 1 = Internacional: 3 primeros minutos $7.59, cada minuto adicional $3.03
//   tipo 2 = Nacional:      3 primeros minutos $1.20, cada minuto adicional $0.48
//   tipo 3 = Local:         las primeras 50 llamadas no se cobran, luego $0.60 c/u
// El fin de datos es tipo 0.
main {
  int tipo, minutos, locales;
  float costo, total;
  total = 0;
  locales = 0;
  cin tipo;
  while (tipo != 0) {
    cin minutos;
    costo = 0;
    if (tipo == 1) then
      costo = 7.59;
      if (minutos > 3) then
        costo = costo + (minutos - 3) * 3.03;
      end
    end
    if (tipo == 2) then
      costo = 1.20;
      if (minutos > 3) then
        costo = costo + (minutos - 3) * 0.48;
      end
    end
    if (tipo == 3) then
      locales++;
      if (locales > 50) then
        costo = 0.60;
      end
    end
    total = total + costo;
    cin tipo;
  }
  cout "Total a pagar: " << total;
}
