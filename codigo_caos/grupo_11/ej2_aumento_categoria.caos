// Ejercicio 2 (selectivo)
// Aumento de sueldo segun la categoria del trabajador:
//   categoria 1: 15%   2: 10%   3: 8%   4: 7%
// Se imprime la categoria y el nuevo sueldo.
main {
  int categoria;
  float sueldo, aumento, nuevo;
  cin categoria;
  cin sueldo;
  aumento = 0;
  if (categoria == 1) then aumento = 0.15; end
  if (categoria == 2) then aumento = 0.10; end
  if (categoria == 3) then aumento = 0.08; end
  if (categoria == 4) then aumento = 0.07; end
  nuevo = sueldo + sueldo * aumento;
  cout "Categoria: " << categoria;
  cout "Nuevo sueldo: " << nuevo;
}
