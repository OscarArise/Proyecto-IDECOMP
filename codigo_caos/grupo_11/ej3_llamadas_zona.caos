// Grupo 11 - Ejercicio 3 (selectivo)
// Costo de una llamada internacional segun la clave de zona y los minutos:
//   12 America del Norte $2     15 America Central $2.2   18 America del Sur $4.5
//   19 Europa $3.5              23 Asia $6                25 Africa $6
//   29 Oceania $5
main {
  int clave, minutos;
  float precio, costo;
  bool valida;
  cin clave;
  cin minutos;
  valida = true;
  precio = 0;
  if (clave == 12) then
    precio = 2;
  else
    if (clave == 15) then
      precio = 2.2;
    else
      if (clave == 18) then
        precio = 4.5;
      else
        if (clave == 19) then
          precio = 3.5;
        else
          if (clave == 23 || clave == 25) then
            precio = 6;
          else
            if (clave == 29) then
              precio = 5;
            else
              valida = false;
            end
          end
        end
      end
    end
  end
  if (valida) then
    costo = precio * minutos;
    cout "Costo de la llamada: " << costo;
  else
    cout "Clave de zona no valida";
  end
}
