// Grupo 6 - Ejercicio 4 (repetitivo)
// Leer N y calcular 1 - 1/2 + 1/3 - 1/4 + ... +- 1/N
main {
  int n, i;
  float suma;
  cin n;
  suma = 0;
  i = 1;
  while (i <= n) {
    if (i % 2 == 1) then
      suma = suma + 1.0 / i;
    else
      suma = suma - 1.0 / i;
    end
    i++;
  }
  cout "Resultado: " << suma;
}
