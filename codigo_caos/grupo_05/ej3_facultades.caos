// Grupo 5 - Ejercicio 3 (selectivo)
// Datos: matricula, carrera, semestre y promedio. Si el alumno es aceptado en
// una facultad menor se imprime su matricula, carrera y "Aceptado = 1".
// Carreras:
//   1 Economia:       semestre >= 6 y promedio >= 8.8
//   2 Computacion:    semestre > 6  y promedio > 8.5
//   3 Administracion: semestre > 5  y promedio > 8.5
//   4 Contabilidad:   semestre > 5  y promedio > 8.5
main {
  int matricula, carrera, semestre;
  float promedio;
  bool aceptado;
  cin matricula;
  cin carrera;
  cin semestre;
  cin promedio;
  aceptado = false;
  if (carrera == 1) then
    aceptado = semestre >= 6 && promedio >= 8.8;
  end
  if (carrera == 2) then
    aceptado = semestre > 6 && promedio > 8.5;
  end
  if (carrera == 3 || carrera == 4) then
    aceptado = semestre > 5 && promedio > 8.5;
  end
  if (aceptado) then
    cout "Matricula: " << matricula;
    cout "Carrera: " << carrera;
    cout "Aceptado = 1";
  else
    cout "No aceptado = 0";
  end
}
